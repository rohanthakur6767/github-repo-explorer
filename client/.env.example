# Copy to ".env" to override the API base URL.
#
# Local development: leave this UNSET. Vite proxies /api to the backend
# (see vite.config.js), so the app uses relative URLs.
#
# Production (Vercel): set this to your deployed backend origin, e.g.
# VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=
