# Copy this file to ".env" and fill in the values.
# The .env file is gitignored and must never be committed.

# Port the API server listens on.
PORT=4000

# Origin of the frontend, used for CORS. Comma-separate multiple origins.
# In production set this to your deployed frontend URL (e.g. https://your-app.vercel.app).
CLIENT_ORIGIN=http://localhost:5173

# Optional GitHub Personal Access Token (no scopes required for public data).
# Without it the GitHub API allows 60 requests/hour; with it, 5000/hour.
GITHUB_TOKEN=

# How long (in milliseconds) to keep a cached GitHub response. Defaults to 60000 (60s).
CACHE_TTL_MS=60000
